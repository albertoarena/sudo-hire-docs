// Cloudflare Workers static assets.
// It serves the site that `npm run build` writes into ./dist. The Deploy workflow builds it first.
// A request that matches no file gets dist/404.html, with the status 404.
{
  "name": "sudohire",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sudohire.dev", "custom_domain": true },
    { "pattern": "www.sudohire.dev", "custom_domain": true }
  ]
}
