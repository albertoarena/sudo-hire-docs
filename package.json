{
  "name": "sudo-hire-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:consent": "SITE_OUT_DIR=dist-consent PUBLIC_GA_MEASUREMENT_ID=G-TESTING000 astro build",
    "preview": "astro preview",
    "preview:consent": "SITE_OUT_DIR=dist-consent astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run build:consent && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "astro": "^7.4.5"
  }
}
