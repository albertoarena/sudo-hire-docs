---
import '../styles/site.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import ExternalIcon from '../components/ExternalIcon.astro';
import { gaMeasurementId } from '../data/analytics';
import { groupOf, groups, pages } from '../data/nav';

interface Props {
  title: string;
  // Only for a page outside the navigation. A page in it takes its description from src/data/nav.ts.
  description?: string;
  home?: boolean;
  // The version of the app that the page was checked against (src/data/app.ts).
  checked?: string;
  // False for the 404 page: noindex, and no canonical.
  indexed?: boolean;
}

const { title, home = false, checked, indexed = true } = Astro.props;
const path = Astro.url.pathname;
const description = pages.find((page) => page.href === path)?.description ?? Astro.props.description ?? '';
const canonicalUrl = new URL(path, Astro.site).href;
// The link preview image: placeholder/og.png, copied to public/. Source in art/og-card.html.
const image = { url: new URL('/og.png', Astro.site).href, width: 1200, height: 630, alt: 'Sudo Hire: “Remote” often does not mean remote from anywhere. A job stamped IT, admitted.' };
const current = groupOf(path);
const documentTitle = home ? 'Sudo Hire' : `${title} | Sudo Hire`;
const utm = 'utm_source=sudohire.dev&utm_medium=referral&utm_campaign=footer';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // The theme that the reader chose, before the first paint. With no choice, the system decides.
      try { const theme = localStorage.getItem('theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
    {indexed ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sudo Hire" />
    {indexed && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to the content</a>
    <header>
      <div class="strip">
        <div class="wrap">
          <a class="name" href="/"><svg class="mark" viewBox="0 0 18 18" aria-hidden="true"><mask id="mark-cut"><rect width="18" height="18" fill="#fff" /><path transform="rotate(-8 9 9)" d="M5.8 9.1 7.9 11.1 12.2 6.9" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></mask><g mask="url(#mark-cut)"><rect transform="rotate(-8 9 9)" x="1.8" y="4.3" width="14.4" height="9.4" rx="1.8" fill="currentColor" /></g></svg>Sudo Hire</a>
          <button class="theme" type="button" data-mode="system" hidden>
            <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" /></svg>
            <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z" /></svg>
            <svg class="screen" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1" /><path d="M5.5 13.5h5M8 11v2.5" /></svg>
            <span class="visually-hidden">Theme: system</span>
          </button>
          <nav class="groups" aria-label="Questions">
            <ul>
              {groups.map((group) => (
                <li><a href={group.pages[0].href} aria-current={group === current ? 'true' : undefined}>{group.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
      {current && (
        <div class="pages">
          <div class="wrap">
            <nav aria-label="Pages">
              <ul>
                {current.pages.map((page) => (
                  <li><a href={page.href} aria-current={page.href === path ? 'page' : undefined}>{page.label}</a></li>
                ))}
              </ul>
            </nav>
            {checked && <p class="checked">Checked against sudo-hire {checked}.</p>}
          </div>
        </div>
      )}
    </header>
    <main id="content" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap">
        <p>Made by <a href={`https://albertoarena.it/?${utm}`} target="_blank" rel="noopener">Alberto Arena<ExternalIcon /><span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
        <p><a href={`https://sudoplay.dev/?${utm}`} target="_blank" rel="noopener">sudoplay.dev<ExternalIcon /><span class="visually-hidden"> (opens in a new tab)</span></a></p>
        {gaMeasurementId && <p><button type="button" class="consent-settings" data-consent-reset>Analytics settings</button></p>}
      </div>
    </footer>
    {gaMeasurementId && <ConsentBanner />}
    <script is:inline>
      // The theme toggle: light, dark, then system. The icon shows the current
      // mode. Light and dark stay in the browser. System removes the choice.
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('button.theme');
        const label = toggle.querySelector('.visually-hidden');
        const order = ['light', 'dark', 'system'];
        const mode = () => root.dataset.theme || 'system';
        const show = () => {
          toggle.dataset.mode = mode();
          label.textContent = `Theme: ${mode()}`;
          toggle.title = `Theme: ${mode()}`;
        };
        toggle.hidden = false;
        show();
        toggle.addEventListener('click', () => {
          const next = order[(order.indexOf(mode()) + 1) % order.length];
          if (next === 'system') delete root.dataset.theme;
          else root.dataset.theme = next;
          try { next === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', next); } catch {}
          show();
        });
      })();

      // "On this page" marks the section in view: the last heading above the top of the reading area.
      (() => {
        const links = [...document.querySelectorAll('.contents a[href^="#"]')];
        const headings = links.map((link) => document.getElementById(link.hash.slice(1)));
        if (!links.length || headings.includes(null)) return;
        const mark = () => {
          const top = document.querySelector('header').getBoundingClientRect().bottom + 32;
          let index = 0;
          headings.forEach((heading, i) => { if (heading.getBoundingClientRect().top <= top) index = i; });
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) index = headings.length - 1;
          links.forEach((link, i) => i === index ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
        };
        let queued = false;
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; mark(); }); } }, { passive: true });
        addEventListener('hashchange', mark);
        mark();
      })();
    </script>
  </body>
</html>
